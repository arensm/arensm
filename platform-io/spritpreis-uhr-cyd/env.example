# DEU: Diese Beispieldatei vor der Verwendung in .env umbenennen.
# DEU: Geheime Werte nur in .env eintragen. .env wird nicht gepusht.
# ENG: Rename this example file to .env before use.
# ENG: Put secret values only in .env. The .env file is not pushed.

# Optional: initial Wi-Fi credentials. Runtime settings stored on the ESP32
# take precedence. Empty values keep the captive-portal setup flow.
SPRITPREIS_WIFI_SSID=
SPRITPREIS_WIFI_PASSWORD=
