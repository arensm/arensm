# DEU: Diese Beispieldatei vor der Verwendung in .env umbenennen.
# DEU: Passwörter und andere geheime Werte nur in .env eintragen.
# DEU: .env wird nicht nach GitHub gepusht.
# ENG: Rename this example file to .env before use.
# ENG: Put passwords and other secrets only in .env.
# ENG: The .env file is not pushed to GitHub.

# Passwort für die Debug-Seite der klassischen Uhren / Debug page password.
CLOCK_DEBUG_PASSWORD=

# Optionale initiale WLAN-Daten der Spritpreis-Uhr. Im ESP32 gespeicherte
# Zugangsdaten haben Vorrang. / Optional initial Wi-Fi credentials for the
# fuel-price clock. Credentials stored on the ESP32 take precedence.
SPRITPREIS_WIFI_SSID=
SPRITPREIS_WIFI_PASSWORD=
